            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sourceInMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
