    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fps": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "durationFrames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
