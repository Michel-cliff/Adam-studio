{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "default": "accent",
      "type": "string"
    },
    "sizeScale": {
      "default": 1,
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "text"
  ],
  "additionalProperties": false
}
